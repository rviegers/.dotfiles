#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: np [SEARCH]" >&2
    echo "Pick a tmux session or repo under ~/repos. Ctrl-D kills a selected session." >&2
}

# Invoked by fzf for the selected row. Keep this separate from the picker so
# the preview can be refreshed without starting another interactive picker.
if [[ ${1-} == --preview ]]; then
    if [[ ${2-} == session ]]; then
        tmux display-message -p -t "$3" '  SESSION  #{session_name}
  Path     #{pane_current_path}' 2>/dev/null || exit 0
        printf '\n  WINDOWS\n'
        tmux list-windows -t "$3" -F '  #{window_index}  #{window_name}#{?window_active,  • active,}' 2>/dev/null || true
        printf '\n  TERMINAL PREVIEW\n\n'
        tmux capture-pane -p -e -t "$3" -S -80 2>/dev/null || true
    elif [[ ${2-} == project ]]; then
        printf '  PROJECT  %s\n  Path     %s\n' "${3##*/}" "$3"
        branch=$(git -C "$3" symbolic-ref --quiet --short HEAD 2>/dev/null || git -C "$3" rev-parse --short HEAD 2>/dev/null || true)
        [[ -z "$branch" ]] || printf '  Branch   %s\n' "$branch"
        printf '\n  FILES\n\n'
        ls -la -- "$3" 2>/dev/null || true
    fi
    exit 0
fi

if (( $# > 1 )); then
    usage
    exit 2
fi

repo_names=()
shopt -s dotglob nullglob
for candidate in "$HOME"/repos/*; do
    [[ -d "$candidate" ]] || continue
    candidate_name=${candidate##*/}
    # These are utility directories in ~/repos, not projects to launch.
    [[ "$candidate_name" == scripts || "$candidate_name" == skills ]] && continue
    repo_names+=("$candidate_name")
done

repo_name=
if (( $# == 1 )); then
    for candidate_name in "${repo_names[@]}"; do
        if [[ "$candidate_name" == "$1" ]]; then
            repo_name=$candidate_name
            break
        fi
    done
fi

if [[ -z "$repo_name" ]]; then
    command -v fzf >/dev/null 2>&1 || {
        echo "fzf is required to choose a repo. Install fzf or pass an exact repo name." >&2
        exit 1
    }
    command -v tmux >/dev/null 2>&1 || {
        echo "tmux is not installed or not on PATH." >&2
        exit 1
    }
    script_path=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/$(basename -- "${BASH_SOURCE[0]}")
    export NP_PREVIEW_SCRIPT="$script_path"
    # Read the same palette selected by the theme command, including before
    # the theme has been applied for the first time.
    palette_root=$(dirname -- "$(dirname -- "$(readlink -f -- "$script_path")")")/themes
    theme_name=rose-pine-moon
    if [[ -r "$HOME/.config/terminal-theme/current" ]]; then
        IFS= read -r theme_name < "$HOME/.config/terminal-theme/current" || true
    fi
    colors=$(python3 -c '
import pathlib, re, sys, tomllib
name = sys.argv[2]
if not re.fullmatch(r"[a-zA-Z0-9_-]+", name):
    raise SystemExit(1)
with (pathlib.Path(sys.argv[1]) / (name + ".toml")).open("rb") as f:
    p = tomllib.load(f)
fields = {"bg":"base", "bg+":"highlight", "fg":"text", "fg+":"text", "border":"muted", "label":"purple", "prompt":"accent", "pointer":"accent", "hl":"rose", "hl+":"rose", "header":"muted", "info":"muted"}
if any(not re.fullmatch(r"#[0-9a-fA-F]{6}", p.get(v, "")) for v in fields.values()):
    raise SystemExit(1)
print(",".join(f"{k}:{p[v]}" for k, v in fields.items()))
' "$palette_root" "$theme_name" 2>/dev/null || true)
    color_options=()
    [[ -z "$colors" ]] || color_options+=("--color=$colors")
    query=${1-}
    while :; do
        # IDs are used as targets so similarly named sessions cannot be confused.
        selection=$(
            {
                printf 'heading\t-\tSessions\n'
                tmux list-sessions -F $'session\t#{session_id}\t  #{session_name}   (#{session_windows} windows)' 2>/dev/null || true
                printf 'heading\t-\t \nheading\t-\tRepos\n'
                for candidate_name in "${repo_names[@]}"; do
                    printf 'project\t%s\t  %s\n' "$HOME/repos/$candidate_name" "$candidate_name"
                done
            } | fzf --delimiter=$'\t' --with-nth=3 --no-sort --ansi \
                "${color_options[@]}" --layout=reverse --border=rounded \
                --border-label=' Workspaces ' --preview-label=' Details ' \
                --pointer='❯' --prompt='  Search  ' \
                --query="$query" --print-query --expect=ctrl-d \
                --header='Enter open   ·   Ctrl-D kill session   ·   Esc close' \
                --preview '"$NP_PREVIEW_SCRIPT" --preview {1} {2}' \
                --preview-window='right,55%,wrap'
        ) || exit 0
        query=${selection%%$'\n'*}
        selection=${selection#*$'\n'}
        key=${selection%%$'\n'*}
        row=${selection#*$'\n'}
        [[ "$row" != "$selection" && -n "$row" ]] || continue
        IFS=$'\t' read -r kind target label <<< "$row"
        [[ "$kind" != heading ]] || continue
        if [[ "$key" == ctrl-d ]]; then
            if [[ "$kind" == session ]]; then
                printf 'Kill %s and all its windows? [y/N] ' "$label" > /dev/tty
                read -r answer < /dev/tty || exit 0
                if [[ "$answer" == y || "$answer" == Y ]]; then
                    tmux kill-session -t "$target" || true
                fi
            fi
            continue
        fi
        if [[ "$kind" == session ]]; then
            if [[ -n ${TMUX-} ]]; then
                exec tmux switch-client -t "$target"
            fi
            exec tmux attach-session -t "$target"
        fi
        repo_name=${target##*/}
        break
    done
fi

repo="$HOME/repos/$repo_name"
repo=$(cd -- "$repo" && pwd -P)

command -v tmux >/dev/null 2>&1 || {
    echo "tmux is not installed or not on PATH." >&2
    exit 1
}

# Use the first hyphen-delimited part when no other repo shares that prefix;
# otherwise keep the full repo name so similarly named repos stay distinct.
short_name=${repo_name%%-*}
session=$short_name
for candidate_name in "${repo_names[@]}"; do
    [[ "$candidate_name" == "$repo_name" ]] && continue
    if [[ "$candidate_name" == "$short_name" || "$candidate_name" == "$short_name-"* ]]; then
        session=$repo_name
        break
    fi
done

# tmux reserves ':' and '.' in target names.
session=${session//:/_}
session=${session//./_}

if tmux has-session -t "=$session" 2>/dev/null; then
    if [[ -n ${TMUX-} ]]; then
        exec tmux switch-client -t "=$session"
    fi
    exec tmux attach-session -t "=$session"
fi

tmux new-session -d -s "$session" -n nvim -c "$repo" nvim
tmux new-window -d -t "=$session" -n codex -c "$repo" codex --no-daemon
tmux new-window -d -t "=$session" -n shell -c "$repo"
tmux select-window -t "=$session:nvim"
if [[ -n ${TMUX-} ]]; then
    exec tmux switch-client -t "=$session"
fi
exec tmux attach-session -t "=$session"
